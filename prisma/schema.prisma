generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./campaign_action_hub.db"
}

enum UserRole {
  VOLUNTEER
  COORDINATOR
  STATE_MANAGER
  NATIONAL_ADMIN
}

enum ActivityStatus {
  DRAFT
  RECRUITING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ApplicationStatus {
  JOINED
  WITHDRAWN
}

enum AssignmentStatus {
  PENDING
  ASSIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  phone         String?
  role          UserRole       @default(VOLUNTEER)
  state         String?
  lga           String?
  ward          String?
  availability  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  skills        UserSkill[]
  applications  Application[]
  assignments   Assignment[]   @relation("VolunteerAssignments")
  coordinated   Activity[]     @relation("ActivityCoordinator")
  verifications Verification[] @relation("VerifiedBy")
}

model Skill {
  id        String     @id @default(cuid())
  name      String     @unique
  users     UserSkill[]
  createdAt DateTime   @default(now())
}

model UserSkill {
  userId  String
  skillId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

model Activity {
  id            String         @id @default(cuid())
  title         String
  description   String?
  state         String?
  lga           String?
  ward          String?
  location      String
  dateTime      DateTime?
  capacity      Int
  status        ActivityStatus @default(RECRUITING)
  coordinatorId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  coordinator   User?          @relation("ActivityCoordinator", fields: [coordinatorId], references: [id])
  applications  Application[]
  assignments   Assignment[]
  verifications Verification[]
}

model Application {
  id         String            @id @default(cuid())
  userId     String
  activityId String
  status     ApplicationStatus @default(JOINED)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

model Assignment {
  id          String           @id @default(cuid())
  userId      String
  activityId  String
  status      AssignmentStatus @default(PENDING)
  assignedAt  DateTime         @default(now())
  completedAt DateTime?

  user         User          @relation("VolunteerAssignments", fields: [userId], references: [id], onDelete: Cascade)
  activity     Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  verification Verification?
}

model Verification {
  id           String             @id @default(cuid())
  assignmentId String             @unique
  activityId   String
  verifiedById String?
  status       VerificationStatus @default(PENDING)
  notes        String?
  submittedAt  DateTime           @default(now())
  verifiedAt   DateTime?

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  verifiedBy User?      @relation("VerifiedBy", fields: [verifiedById], references: [id])
}

model Location {
  id        String   @id @default(cuid())
  state     String
  lga       String
  ward      String?
  createdAt DateTime @default(now())

  @@unique([state, lga, ward])
}
